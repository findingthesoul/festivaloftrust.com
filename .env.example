# The Fibre app key: scoped to fot-planner in one workspace.
#
# Minted by a workspace admin once the app is approved and activated. Server
# side only — src/lib/fibre.ts throws if it is ever imported on the client,
# because a key in a bundle is a key given to every visitor.
FIBRE_APP_KEY=

# Defaults to production; set for a local API.
# FIBRE_API_URL=http://localhost:8080


# The flow the planner runs. Matched on system_key, never by name or position:
# the app key can see every workspace flow, including the sales pipeline.
# FIBRE_FLOW_SYSTEM_KEY=fot_festival
