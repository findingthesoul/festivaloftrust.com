{
  "$schema": "https://thefibre.app/schemas/fibre-app-manifest.v1.json",
  "app_slug": "fot-planner",
  "app_name": "Festival planner",
  "version": "0.2.0",
  "description": "Plans a Festival of Trust across the nine steps of the work, running on Fibre Flow.",

  "scopes_requested": [
    "read:flows",
    "write:flow_runs",
    "read:persons",
    "write:persons",
    "read:organisations",
    "write:organisations",
    "write:activities"
  ],

  "entity_mappings": [
    {
      "app_entity": "festival_organiser",
      "platform_entity": "person",
      "mapping_kind": "identity",
      "match_on": ["email"],
      "description": "The person organising a festival IS a Fibre person; matched on email."
    },
    {
      "app_entity": "festival_host",
      "platform_entity": "organisation",
      "mapping_kind": "reference",
      "match_on": ["domain", "name"],
      "description": "The hosting community or organisation."
    }
  ],

  "curator_fields": [],

  "activity_types": [
    { "type": "fot_planner_plan_created", "subject": "Started planning {festival_name}" },
    { "type": "fot_planner_plan_updated", "subject": "Updated the plan for {festival_name}" },
    { "type": "fot_planner_offer_issued", "subject": "Offer issued for {festival_name}" }
  ]
}
